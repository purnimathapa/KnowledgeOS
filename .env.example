NEXT_PUBLIC_SUPABASE_URL=
# Settings → API → publishable (anon) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Groq API key (starts with gsk_…): https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: skip confirmation emails during local dev (Dashboard → Settings → API → service_role).
# Never expose this key to the browser or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=
